{
  "name": "smart-thinking-mcp",
  "version": "16.1.0",
  "description": "Public remote MCP client for Smart-Thinking: exact math, verified reasoning, search and evidence. No token required; the engine runs on the hosted server.",
  "type": "module",
  "main": "clients/remote-mcp/connection.mjs",
  "exports": {
    ".": "./clients/remote-mcp/connection.mjs",
    "./protocol": "./clients/remote-mcp/protocol.mjs",
    "./clients/remote-mcp/*.mjs": "./clients/remote-mcp/*.mjs"
  },
  "bin": {
    "smart-thinking-mcp": "bin/smart-thinking.mjs"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leghis/Smart-Thinking.git"
  },
  "files": [
    "bin",
    "clients/remote-mcp/*.mjs",
    "contracts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/smart-thinking.mjs",
    "build": "node scripts/check-syntax.mjs",
    "test": "node --test clients/remote-mcp/tests/*.test.mjs scripts/tests/*.test.mjs",
    "doctor": "node clients/remote-mcp/doctor.mjs --allow-network",
    "test:boundary": "node scripts/v14-check-public.mjs",
    "test:pack": "node scripts/v14-test-package.mjs",
    "check": "npm run build && npm test && npm run test:boundary && npm run test:pack",
    "prepublishOnly": "npm run check"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "reasoning",
    "verification",
    "exact-math",
    "ai-tools"
  ]
}
